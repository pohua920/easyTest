<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts PUBLIC
	"-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
	"http://struts.apache.org/dtds/struts-2.0.dtd">
<struts>
   <!-- 核赔权限管理 -->
   <package name="platformpower" extends="default" >
        <!-- 机构权限配置 - 双核条件 -->
		<action name="processUwCondition" class="utiUwConditionAction">
	      <result name="main">/pages/platform/uwcondition/Main.jsp</result>
	      <result name="prepareQuery">/pages/platform/uwcondition/QueryUwConditionOverview.jsp?actionType=query</result>
	      <result name="query">/pages/platform/uwcondition/QueryUwConditionOverview.jsp?actionType=queryContinue</result>
	      <result name="queryContinue">/pages/platform/uwcondition/QueryUwConditionOverview.jsp?actionType=queryContinue</result>
	      <result name="prepareInsert">/pages/platform/uwcondition/InsertUwCondition.jsp?actionType=prepareInsert2</result>
	      <!-- <result name="prepareInsert2">/pages/platform/uwcondition/InsertUwConditionMain.jsp</result>-->
	      <result name="insertUtiUwCondition2">/pages/platform/uwcondition/InsertUwCondition2.jsp</result>
	      <result name="prepareInsert2">/pages/platform/uwcondition/InsertUwCondition2.jsp</result>
	      <result name="prepareInsertUtiUwLevel">/pages/platform/uwcondition/InsertUwCondition3.jsp</result>
	      <result name="insertUtiUwCondition" type="redirect">/processUwCondition.do?actionType=insertUtiUwCondition2</result>
	      <result name="insertUtiUwLevel" type="redirect">/processUwCondition.do?actionType=prepareInsertUtiUwLevel</result>
	      <result name="prepareUpdate">/pages/platform/uwcondition/EditUwCondition3.jsp</result>
	      <result name="update" type="redirect">/processUwCondition.do?actionType=queryContinue</result>
	      <!-- <result name="prepareUpdate2">/pages/platform/uwcondition/EditUwConditionMain.jsp</result>-->
	      <result name="prepareUpdate2">/pages/platform/uwcondition/InsertUwCondition2.jsp</result>
	      <result name="prepareUpdateUtiUwCondition">/pages/platform/uwcondition/EditUwCondition.jsp</result>
	      <result name="prepareUpdateUtiUwLevel">/pages/platform/uwcondition/EditUwCondition2.jsp</result>
	      <result name="updateUtiUwCondition" type="redirect">/processUwCondition.do?actionType=prepareUpdateUtiUwCondition</result>
	      <result name="updateUtiUwLevel" type="redirect">/processUwCondition.do?actionType=prepareUpdateUtiUwLevel</result>
	      <result name="delete" type="redirect">/processUwCondition.do?actionType=queryContinue</result>
		</action>
		<!-- 机构权限配置 - 双核因子 -->
		<action name="processUwFactor" class="utiUwFactorAction">
	      <result name="prepareQuery">/pages/platform/uwcondition/QueryUwFactorOverview.jsp?actionType=query</result>
	      <result name="query">/pages/platform/uwcondition/QueryUwFactorOverview.jsp?actionType=queryContinue</result>
	      <result name="queryContinue">/pages/platform/uwcondition/QueryUwFactorOverview.jsp?actionType=queryContinue</result>
	      <result name="prepareUpdate">/pages/platform/uwcondition/EditUwFactor.jsp?actionType=update</result>
	      <result name="update" type="redirect">/processUwFactor.do?actionType=queryContinue</result>
	      <result name="openTip">/pages/platform/uwcondition/FactorTip.jsp</result>
		</action>
		<!-- 人员权限配置 -->
	    <action name="processUwLevel" class="com.sinosoft.claim.undwrt.web.UtiUwLevelAction">
	      <result name="uwLevelmain">/pages/platform/uwlevel/UwLevelMain.jsp</result>
	      <result name="prepareQuery">/pages/platform/uwlevel/QueryUwLevelOverview.jsp?actionType=query</result>
	      <result name="query">/pages/platform/uwlevel/QueryUwLevelOverview.jsp?actionType=queryContinue</result>
	      <result name="queryContinue">/pages/platform/uwlevel/QueryUwLevelOverview.jsp?actionType=queryContinue</result>
	      <result name="prepareInsert">/pages/platform/uwlevel/PrepareInsertUwLevel.jsp?actionType=prepareInsertUwLevel2</result>
	      <result name="prepareInsertUwLevel2">/pages/platform/uwlevel/InsertUwLevelMain.jsp</result>
	      <result name="insertUwLevel">/pages/platform/uwlevel/InsertUwLevel.jsp</result>
	      <result name="insertUwLevel2" type="redirect">/processUwLevel.do?actionType=insertUwLevel</result>
	      <result name="prepareUpdate">/pages/platform/uwlevel/UpdateUwLevelMain.jsp</result>
	      <result name="update" type="redirect">/processUwLevel.do?actionType=queryContinue</result>
	      <result name="updateContinue" type="redirect">/processUwLevel.do?actionType=prepareInsertUwLevel2</result>
	      <result name="delete" type="redirect">/processUwLevel.do?actionType=queryContinue</result>
	    </action>
	    
	    <action name="processUwUserCondition" class="com.sinosoft.claim.undwrt.web.UtiUwUserConditionAction">
      	  <result name="prepareUpdate">/pages/platform/uwcondition/EditUwUserCondition.jsp</result>
	      <result name="update" type="redirect">/processUwUserCondition.do?actionType=prepareUpdate</result>
	      <result name="delete" type="redirect">/processUwCondition.do?actionType=prepareUpdateUtiUwLevel</result>
	      <result name="beforeUpdate">/pages/platform/uwusercondition/BeforeUpdateInclud.jsp</result>
	    </action>
   </package>
</struts>