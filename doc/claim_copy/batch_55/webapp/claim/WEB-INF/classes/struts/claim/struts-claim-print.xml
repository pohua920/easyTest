<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE struts PUBLIC
        "-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
        "http://struts.apache.org/dtds/struts-2.0.dtd">

<struts>
	<package name="print" extends="struts-default" namespace="/print">
		<action name="claimPrint" class="claimPrintAction" method="claimPrint">
			<interceptor-ref name="paramsPrepareParamsStack"></interceptor-ref>
		</action>
		<action name="claimPrintCheck" class="claimPrintAction" method="claimPrintCheck">
			<interceptor-ref name="paramsPrepareParamsStack"></interceptor-ref>
		</action>
	</package>
	<package name="jasperreports" extends="default">
		<result-types>
			<result-type name="jasper"
				class="org.apache.struts2.views.jasperreports.JasperReportsResult" />
		</result-types>
		<action name="JRAcci*" class="com.sinosoft.claim.print.web.AcciPrintAction" method="print{1}">
			<result name="success" type="jasper">
				<param name="location">/printReport/Acci/{1}.jasper</param><!-- location:指定.jasper文件的位置. -->
				<param name="dataSource">resultList</param><!-- dataSource:指定一个集合属性名 -->
				<!--<param name="connection">connection</param> --><!-- 报表需要的数据源 connection和dataSource不能共存。两个共存时，优先级是connection高 -->
				<param name="format">${format}</param><!-- format:指定生成的报表文件的格式,如果不指定,默认生成PDF文件（XLS：excel格式，HTML：html格式，CSV，XML） -->
				<param name="reportParameters">param</param>
			</result>
		</action>
		<action name="JRCommon*" class="com.sinosoft.claim.print.web.CommonAction">
			<result name="success" type="jasper">
				<param name="location">/printReport/Prop/{1}.jasper</param><!-- location:指定.jasper文件的位置. -->
				<param name="dataSource">resultList</param>
				<param name="format">PDF</param><!-- format:指定生成的报表文件的格式,如果不指定,默认生成PDF文件（XLS：excel格式，HTML：html格式，CSV，XML） -->
				<param name="reportParameters">param</param>
			</result>
		</action>
		<action name="JRProp*" class="com.sinosoft.claim.print.web.PropPrintAction" method="print{1}">
			<interceptor-ref name="paramsPrepareParamsStack"></interceptor-ref>
			<result name="success" type="jasper">
				<param name="location">/printReport/Prop/{1}.jasper</param><!-- location:指定.jasper文件的位置. -->
				<param name="dataSource">resultList</param><!-- dataSource:指定一个集合属性名 -->
				<!--<param name="connection">connection</param> --><!-- 报表需要的数据源 connection和dataSource不能共存。两个共存时，优先级是connection高 -->
				<param name="format">PDF</param><!-- format:指定生成的报表文件的格式,如果不指定,默认生成PDF文件（XLS：excel格式，HTML：html格式，CSV，XML） -->
				<param name="reportParameters">param</param>
			</result>
		</action>
		<action name="JRShip*" class="com.sinosoft.claim.print.web.ShipPrintAction" method="print{1}">
			<interceptor-ref name="paramsPrepareParamsStack"></interceptor-ref>
			<result name="success" type="jasper">
				<param name="location">/printReport/Ship/{1}.jasper</param><!-- location:指定.jasper文件的位置. -->
				<param name="dataSource">resultList</param><!-- dataSource:指定一个集合属性名 -->
				<!--<param name="connection">connection</param> --><!-- 报表需要的数据源 connection和dataSource不能共存。两个共存时，优先级是connection高 -->
				<param name="format">PDF</param><!-- format:指定生成的报表文件的格式,如果不指定,默认生成PDF文件（XLS：excel格式，HTML：html格式，CSV，XML） -->
				<param name="reportParameters">param</param>
			</result>
		</action>
		<action name="JRLiab*" class="com.sinosoft.claim.print.web.LiabPrintAction" method="print{1}">
			<interceptor-ref name="paramsPrepareParamsStack"></interceptor-ref>
			<result name="success" type="jasper">
				<param name="location">/printReport/Liab/{1}.jasper</param><!-- location:指定.jasper文件的位置. -->
				<param name="dataSource">resultList</param><!-- dataSource:指定一个集合属性名 -->
				<param name="format">PDF</param><!-- format:指定生成的报表文件的格式,如果不指定,默认生成PDF文件（XLS：excel格式，HTML：html格式，CSV，XML） -->
				<param name="reportParameters">param</param>
			</result>
		</action>
		<!-- 工程险列印处理 -->
		<action name="JRGAA*" class="com.sinosoft.claim.print.web.GAAPrintAction" method="print{1}">
			<interceptor-ref name="paramsPrepareParamsStack"></interceptor-ref>
			<result name="success" type="jasper">
				<param name="location">/printReport/GAA/{1}.jasper</param><!-- location:指定.jasper文件的位置. -->
				<param name="dataSource">resultList</param><!-- dataSource:指定一个集合属性名 -->
				<!--<param name="connection">connection</param> --><!-- 报表需要的数据源 connection和dataSource不能共存。两个共存时，优先级是connection高 -->
				<param name="format">PDF</param><!-- format:指定生成的报表文件的格式,如果不指定,默认生成PDF文件（XLS：excel格式，HTML：html格式，CSV，XML） -->
				<param name="reportParameters">param</param>
			</result>
		</action>
		<action name="JRTimes*" class="com.sinosoft.claim.print.web.PrintTimesAction" method="printTimes{1}"><!-- 一次列印多张报表 -->
		    <interceptor-ref name="paramsPrepareParamsStack"></interceptor-ref>
	    </action>
	</package>
</struts>