<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE struts PUBLIC
	"-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
	"http://struts.apache.org/dtds/struts-2.0.dtd">

<struts>

	<package name="user" extends="default" namespace="/user">

		<action name="query" class="userAction" method="query" />

		<action name="delete" class="userAction" method="delete" />
		<action name="prepareQuery" class="userAction" method="prepareQuery">
			<result name="success">
				/pages/platform/user/PerfUserList.jsp
			</result>
		</action>
		<action name="prepareUpdate" class="userAction" method="prepareUpdate">
			<result name="success">
				/pages/platform/user/PerfUserEdit.jsp
			</result>
		</action>
		<action name="prepareAdd" class="userAction" method="prepareAdd">
			<result name="success">
				/pages/platform/user/PerfUserAdd.jsp
			</result>
		</action>
		<action name="add" class="userAction" method="add">
			<result name="success">/common/Success.jsp</result>
			<result name="input">/testValidator.jsp</result>
		</action>
		<action name="update" class="userAction" method="update">
			<result name="success">/common/Success.jsp</result>
		</action>
		<action name="view" class="userAction" method="view">
			<result name="success">
				/pages/platform/user/PerfUserEdit.jsp
			</result>
		</action>
		<!-- 修改密码 -->
		<action name="prepareChUserPw" class="userAction" method="prepareChUserPw">
			<result name="success">
				/pages/platform/user/PerfUserChPw.jsp
			</result>
		</action>
		<!-- 帮助页面 -->
		<action name="help" class="userAction" method="help">
			<result name="helpPage">
				/common/help.jsp
			</result>
		</action>
		<action name="ChUserPw" class="userAction" method="ChUserPw">
			<result name="success">
				/common/Success.jsp
			</result>
		</action>
		<!-- 验证人员工号 -->
		<action name="checkUserCode" class="userAction" method="checkUserCode">
		</action>
	</package>
</struts>
