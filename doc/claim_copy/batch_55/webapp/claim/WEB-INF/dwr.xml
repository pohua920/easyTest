<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dwr PUBLIC "-//GetAhead Limited//DTD Direct Web Remoting 2.0//EN" "http://getahead.org/dwr/dwr20.dtd">

<dwr>
	<allow>
    	<create creator="spring"  javascript="dwrInvokeDataAction">
			<param name="beanName" value="dwrInvokeDataAction"/>
    	</create>
		<convert converter="bean" match="ins.platform.sui.ac.vo.*" />
		<convert converter="bean" match="com.sinosoft.app.common.vo.*" />
		<convert converter="bean" match="com.sinosoft.claim.dto.custom.*"/>
	    <convert converter="bean" match="com.sinosoft.claim.dto.domain.*"/>
	    <convert converter="bean" match="com.sinosoft.claimciplatform.dto.custom.*"/>
	    <convert converter="bean" match="com.sinosoft.platform.dto.domain.*" ></convert>
	    <!-- 迁移后系统对象的转换 主要是DWR 构建对象与迁移后DTO相互转换-->
	    <convert converter="bean" match="com.sinosoft.app.common.model.*"/>
	    <convert converter="bean" match="com.sinosoft.app.common.vo.*"/>
	    <convert converter="bean" match="com.sinosoft.claim.archive.vo.*"/>
	    <convert converter="bean" match="com.sinosoft.claim.certainLoss.vo.*"/>
	    <convert converter="bean" match="com.sinosoft.claim.certify.vo.*"/>
	    <convert converter="bean" match="com.sinosoft.claim.check.vo.*"/>
	    <convert converter="bean" match="com.sinosoft.claim.claim.vo.*"/>
	    <convert converter="bean" match="com.sinosoft.claim.common.vo.*"/>
	    <convert converter="bean" match="com.sinosoft.claim.compensate.vo.*"/>
	    <convert converter="bean" match="com.sinosoft.claim.endcase.vo.*"/>
	    <convert converter="bean" match="com.sinosoft.claim.regist.vo.*"/>
	    <convert converter="bean" match="com.sinosoft.claim.schedule.vo.*"/>
	    <convert converter="bean" match="com.sinosoft.claim.schema.model.*"/>
	    <convert converter="bean" match="com.sinosoft.claim.verifyLoss.vo.*"/>
	    <convert converter="bean" match="com.sinosoft.claim.workflow.vo.*"/>
	    <convert converter="exception" match="java.lang.Exception"/> 
	</allow>
  <!-- 旧系统导入 
  <allow>
    <create creator="new" javascript="dwrInvokeDataAction">
        <param name="class" value="com.sinosoft.claim.ui.control.action.DwrInvokeDataAction"/>
    </create>
    <convert converter="bean" match="com.sinosoft.claim.dto.custom.*"/>
    <convert converter="bean" match="com.sinosoft.claim.dto.domain.*"/>
    <convert converter="bean" match="com.sinosoft.claimciplatform.dto.custom.*"/>
    <convert converter="bean" match="com.sinosoft.platform.dto.domain.*" ></convert>
  </allow>
  -->
  <!-- 整合部分 start -->
  <allow>
		<create creator="spring"  javascript="dwrCodeAction">
			<param name="beanName" value="dwrCodeAction"/>
    	</create>
  </allow>
  <allow>
		<create creator="new" javascript="JDate">
			<param name="class" value="java.util.Date" />
		</create>
		<convert converter="bean" match="ins.platform.sui.ac.vo.*" />
		<convert converter="bean" match="com.sinosoft.app.common.vo.*" />
  </allow>
  <allow>
		<create creator="new" javascript="timeUtil">
			<param name="class" value="com.sinosoft.app.common.util.TimeUtil" />
			<include method="getDate"/>
			<include method="getWeekThursday"/>
			<include method="compareCurTime"/>
		</create>
  </allow>
  <allow>
    <create creator="new" javascript="uiAccountCodeAction">
        <param name="class" value="com.sinosoft.claim.common.util.UIAccountCodeAction"/>
        <include method="checkAccountNo"/>
        <include method="saveAccount"/>
    </create>
    <convert converter="bean" match="com.sinosoft.claim.schema.model.*"/>
    <convert converter="bean" match="com.sinosoft.claim.dto.custom.*"/>
    <convert converter="bean" match="com.sinosoft.claim.dto.domain.*"/>
    <convert converter="exception" match="java.lang.Exception"/> 
  </allow>
  <!-- 整合部分 end -->
