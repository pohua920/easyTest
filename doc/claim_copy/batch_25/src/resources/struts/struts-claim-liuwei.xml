<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts PUBLIC
	"-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
	"http://struts.apache.org/dtds/struts-2.0.dtd">
<struts>
	<!-- 联共保处理 -->
	<package name="compensateCoins" extends="default" namespace="/">
		<action name="compensateCoins" class="com.sinosoft.claim.compensate.web.CompensateCoinsPostEditAction"
			method="compensateCoinsPostEdit">
			<result name="coins">/pages/common/compensate/CompensateCoinsEdit.jsp</result>
		</action>
	</package>
	<!-- 火险列印处理 -->
	<package name="propPrint" extends="default" namespace="/">
		<action name="propPrintBeforeEdit" class="com.sinosoft.claim.print.web.PropPrintBeforeEditAction"
			method="propPrintBeforeEdit">
			<result name="propPrint">/pages/commonProp/print/PropPrintBeforeEdit.jsp</result>
		</action>
		<action name="checkBizNo" class="com.sinosoft.claim.print.web.PropPrintBeforeEditAction"
			method="checkBizNo">
		</action>
	</package>
	<!-- 责任险列印处理 -->
	<package name="liabPrint" extends="default" namespace="/">
		<action name="liabPrintBeforeEdit" class="com.sinosoft.claim.print.web.LiabPrintBeforeEditAction"
			method="liabPrintBeforeEdit">
			<result name="liabPrint">/pages/commonLiab/print/LiabPrintBeforeEdit.jsp</result>
		</action>
		<action name="checkBizNo" class="com.sinosoft.claim.print.web.LiabPrintBeforeEditAction"
			method="checkBizNo">
		</action>
	</package>
	<!-- 工程险列印处理 -->
	<package name="gaaPrint" extends="default" namespace="/">
		<action name="gaaPrintBeforeEdit" class="com.sinosoft.claim.print.web.GAAPrintBeforeEditAction"
			method="gaaPrintBeforeEdit">
			<result name="gaaPrint">/pages/common/print/GAAPrintBeforeEdit.jsp</result>
		</action>
		<action name="checkBizNo" class="com.sinosoft.claim.print.web.GAAPrintBeforeEditAction"
			method="checkBizNo">
		</action>
	</package>

</struts>