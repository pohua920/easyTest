<struts>
	<!-- 工作流部分 -->
	<package name="workflow" extends="default" namespace="/workflow">
		<action name="processWorkflow" class="processWorkflowAction" method="processWorkflow">
		</action>
		<action name="swfFlowQuery" class="com.sinosoft.claim.workflow.web.WorkFlowQueryAction" method="workFlowQuery">
		    <result name="success">/pages/workflow/flow/WorkFlowFlowQueryRegistList.jsp</result><!-- 已改为异步查询，此处可略去 -->
		</action>
		<action name="swfFlowBeforeQuery" class="com.sinosoft.claim.workflow.web.WorkFlowBeforeQueryAction" method="workFlowBeforeQuery">
		    <result name="success">/pages/workflow/flow/WorkFlowFlowQueryList.jsp</result>
      		<result name="taskView">/pages/common/query/TaskView.jsp</result>
		</action>
	</package>
	
	<!-- 查勘 处理-->
	<package name="check" extends="default" namespace="/check">
		<action name="checkEditPost" class="checkEditPostAction" method="checkEditPost">
			<result name="false">/index.jsp</result>
		</action>
		<action name="checkBeforeEdit" class="checkBeforeEditAction" method="checkBeforeEdit">
			<result name="ADDDAA">/pages/DAA/check/DAACheckEdit.jsp</result>
			<result name="ADDGAA">/pages/GAA/check/GAACheckEdit.jsp</result>
			<result name="ADDProp">/pages/commonProp/check/PropCheckEdit.jsp</result>
			<result name="ADDCAA">/pages/commonShip/check/ShipCheckEdit.jsp</result>
			<result name="ADDYAA">/pages/commonShip/check/ShipCheckEdit.jsp</result>
			<result name="ADDZAA">/pages/commonLiab/check/LiabCheckEdit.jsp</result>
			<result name="ADDEAA">/pages/commonAcci/check/AcciCheckEdit.jsp</result>
			<result name="EDITDAA">/pages/DAA/check/DAACheckEdit.jsp</result>
			<result name="EDITGAA">/pages/GAA/check/GAACheckEdit.jsp</result>
			<result name="EDITProp">/pages/commonProp/check/PropCheckEdit.jsp</result>
			<result name="EDITCAA">/pages/commonShip/check/ShipCheckEdit.jsp</result>
			<result name="EDITYAA">/pages/commonShip/check/ShipCheckEdit.jsp</result>
			<result name="EDITZAA">/pages/commonLiab/check/LiabCheckEdit.jsp</result>
			<result name="EDITEAA">/pages/commonAcci/check/AcciCheckEdit.jsp</result>
		</action>
		<action name="checkFinishQueryList" class="checkBeforeEditAction" method="checkBeforeEdit">
			<result name="ADDDAA">/pages/DAA/check/DAACheckEdit.jsp</result>
			<result name="ADDGAA">/pages/GAA/check/GAACheckEdit.jsp</result>
			<result name="ADDProp">/pages/commonProp/check/PropCheckEdit.jsp</result>
			<result name="ADDCAA">/pages/commonShip/check/ShipCheckEdit.jsp</result>
			<result name="ADDYAA">/pages/commonShip/check/ShipCheckEdit.jsp</result>
			<result name="ADDZAA">/pages/commonLiab/check/LiabCheckEdit.jsp</result>
			<result name="ADDEAA">/pages/commonAcci/check/AcciCheckEdit.jsp</result>
			<result name="EDITDAA">/pages/DAA/check/DAACheckEdit.jsp</result>
			<result name="EDITGAA">/pages/GAA/check/GAACheckEdit.jsp</result>
			<result name="EDITProp">/pages/commonProp/check/PropCheckEdit.jsp</result>
			<result name="EDITCAA">/pages/commonShip/check/ShipCheckEdit.jsp</result>
			<result name="EDITYAA">/pages/commonShip/check/ShipCheckEdit.jsp</result>
			<result name="EDITZAA">/pages/commonLiab/check/LiabCheckEdit.jsp</result>
			<result name="EDITEAA">/pages/commonAcci/check/AcciCheckEdit.jsp</result>
		</action>
		<action name="checkQuery" class="checkQueryAction" method="query"/>
		<action name="checkAcciEdit" class="com.sinosoft.claim.check.web.ApplyScheduleEditPostAction" method="checkAcciEdit">
		</action>
		<action name="lacciCheckBeforeQuery" class="checkQueryAction" method="acciCheckQuery">
			<result name="target1" >/pages/common/check/QueryPrpLacciCheckOverviewResult.jsp</result>
		</action>
	</package>
	
	<package name="claimdefault" extends="default">
		<action name="wfLogQuery" class="com.sinosoft.claim.workflow.web.WorkFlowLogQueryEditAction" method="workFlowLogQueryEdit">
			<result name="success">/pages/workflow/task/query/SwfLog${nodeType}QueryResultList.jsp</result>
			<result name="specialQuery">/pages/common/specialCase/SpecialCaseQueryList.jsp</result>
			<result name="urgentCase">/pages/common/compensate/UrgentCaseList.jsp</result>
		</action>
		<!-- 双击域查询 -->
		<action name="processClaimCodeInput" class="codeInputAction" method="query">
			<result name="query">/pages/common/pub/QueryCodeInputResult.jsp</result>
			<result name="queryLogon">/pages/common/pub/QueryCodeInputOverviewResult.jsp</result>
			<result name="queryContinue">/pages/common/pub/QueryCodeInputResult.jsp</result>
		</action>
		<!-- 平台功能双击域查询 -->
		<action name="processClaimPlatFormCodeInput" class="com.sinosoft.claim.undwrt.web.CodeInputAction">
			<result name="query">/pages/platform/common/QueryCodeInputOverviewResult.jsp</result>
		</action>
		<action name="taskQuery" class="com.sinosoft.claim.common.web.TaskQueryAction" method="taskQuery">
			<result name="ClaimTask">/pages/common/query/ClaimTaskQueryResult.jsp</result>
			<result name="UndwrtTaskInfo">/pages/common/query/UndwrtTaskInfoQueryResult.jsp</result>
			<result name="UndwrtTaskPayInfo">/pages/common/query/UndwrtTaskPayInfoQueryResult.jsp</result>
		</action>
		<action name="beforeTaskQuery" class="com.sinosoft.claim.common.web.TaskQueryAction" method="beforeTaskQuery">
			<result name="ClaimTask">/pages/common/query/ClaimTaskQuery.jsp</result>
			<result name="UndwrtTaskInfo">/pages/common/query/UndwrtTaskInfoQuery.jsp</result>
			<result name="UndwrtTaskPayInfo">/pages/common/query/UndwrtTaskPayInfoQuery.jsp</result>
			<!-- add by songxin 需求169報送保發部分 20170510 -->
			<result name="SendToTiiQuery">/pages/common/query/SendToTiiQuery.jsp</result>
		</action>              
		<action name="queryExport" class="com.sinosoft.claim.common.web.TaskQueryAction" method="queryExport"/>
		<!-- 應追償未追償查詢 -->
		<action name="claimReplevyQuery" class="com.sinosoft.claim.common.web.ClaimQueryAction" method="claimReplevyQuery">
			<result name="success">/pages/common/query/ClaimReplevyQueryResult.jsp</result>
		</action>
		<!-- 已追償明細查詢 -->
		<action name="claimRepleviedQuery" class="com.sinosoft.claim.common.web.ClaimQueryAction" method="claimRepleviedQuery">
			<result name="success">/pages/common/query/ClaimRepleviedQueryResult.jsp</result>
		</action>
		<!-- 未決賠案明細查詢 -->
		<action name="claimOutstandingQuery" class="com.sinosoft.claim.common.web.ClaimQueryAction" method="claimOutstandingQuery">
			<result name="success">/pages/common/query/ClaimOutstandingQueryResult.jsp</result>
		</action>
		<!-- 已決賠案明細查詢 -->
		<action name="claimSettledQuery" class="com.sinosoft.claim.common.web.ClaimQueryAction" method="claimSettledQuery">
			<result name="success">/pages/common/query/ClaimSettledQueryResult.jsp</result>
		</action>
		<!-- mantis：CLM0265，處理人員：DP0713，需求單編號：新核心-DP自動化功能 START-->
		<action name="payObjectInfoQuery" class="com.sinosoft.claim.dpCase.web.DpFlowAction" method="payObjectInfoQuery">
			<result name="dpFlowQuery">/pages/workflow/task/query/PayObjectInfoQueryEdit.jsp</result>
		</action>
		<action name="payObjectInfoEdit" class="com.sinosoft.claim.dpCase.web.DpFlowAction" method="payObjectInfoEdit">
	      <result name="success" >/pages/DAA/compensate/PayObjectInfoDpEdit.jsp</result>
	      <result name="failure">/pages/undwrt/common/Message.jsp</result>
		</action>
		<action name="payObjectInfoCheck" class="com.sinosoft.claim.dpCase.web.DpFlowAction" method="payObjectInfoCheck">
	      <result name="success">/pages/undwrt/common/Message.jsp</result>
		</action>
		<action name="payObjectInfoPass" class="com.sinosoft.claim.dpCase.web.DpFlowAction" method="payObjectInfoPass">
	      <result name="success">/pages/undwrt/common/Message.jsp</result>
		</action>
		<action name="payObjectInfoReject" class="com.sinosoft.claim.dpCase.web.DpFlowAction" method="payObjectInfoReject">
	      <result name="success">/pages/undwrt/common/Message.jsp</result>
		</action>
		<!-- mantis：CLM0265，處理人員：DP0713，需求單編號：新核心-DP自動化功能 END-->
	</package>
</struts>