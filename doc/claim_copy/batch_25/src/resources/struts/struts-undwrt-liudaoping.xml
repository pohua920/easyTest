<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts PUBLIC
	"-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
	"http://struts.apache.org/dtds/struts-2.0.dtd">

<struts>
	<package name="undwrt" extends="default">
	    <!--添加核赔任务处理功能 -->
	    <action name="hepeiTaskDeal" class="undwrtTaskDealAction" method="undwrtTaskDeal">
	      <result name="prepareQuery">/pages/undwrt/hepei/HepeiTaskDealQuery.jsp</result>
	      <result name="query">/pages/undwrt/hepei/HepeiTaskDealQueryResult.jsp</result>
	      <result name="hepeiQueryContinue">/pages/undwrt/hepei/HepeiTaskDealQueryResult.jsp</result>
	      <result name="failure">/pages/undwrt/common/Message.jsp</result>
	    </action>
	    <!-- mantis：CLM0241，處理人員： DP0713 ，需求單編號：強制任意批次核賠功能新增 START-->
	    <action name="hepeiHeapTaskDeal" class="undwrtTaskDealAction" method="undwrtHeapTaskDeal">
	      <result name="prepareQuery">/pages/undwrt/hepei/HepeiHeapTaskDealQuery.jsp</result>
	      <result name="query">/pages/undwrt/hepei/HepeiHeapTaskDealQueryResult.jsp</result>
	      <result name="hepeiQueryContinue">/pages/undwrt/hepei/HepeiHeapTaskDealQueryResult.jsp</result>
	      <result name="failure">/pages/undwrt/common/Message.jsp</result>
	    </action>
	    <!-- 批次任务校验 -->
	    <action name="CommonHeapCheckTask" class="commonCheckTaskAction" method="commonHeapCheckTask">
	      <result name="success">/pages/undwrt/common/CommonHeapDealContent.jsp</result>
	      <result name="noData">/pages/undwrt/hepei/HepeiHeapTaskDealQuery.jsp</result>
	      <result name="EndorseSuccess">/pages/undwrt/common/EndorseHeapDealContent.jsp</result>
	      <result name="failure">/pages/undwrt/common/Message.jsp</result>
	      <result name="fail">/pages/undwrt/common/CheckAdvanceErrorPage.jsp</result>
	      <result name="undoTask">/pages/undwrt/common/Message.jsp</result>
	    </action>
		<action name="heapToExcel" class="commonCheckTaskAction" method="heapToExcel">
			<result name="success">/pages/workflow/task/query/SwfLog${nodeType}QueryResultList.jsp</result>
		</action>
		<action name="CommonHeapSubmitTask" class="commonDealSubmitAction" method="commonDealHeapSubmit">
	      <result name="success">/pages/undwrt/common/Message.jsp</result>
	      <result name="failure">/pages/undwrt/common/CheckAdvanceConditionErrorPage.jsp</result>
	    </action>
	    <action name="CommonHeapDealTask" class="commonCheckTaskAction" method="commonHeapDealTask">
	      <result name="undoTask">/pages/undwrt/common/Message.jsp</result>
	    </action>
	    <!-- mantis：CLM0241，處理人員： DP0713 ，需求單編號：強制任意批次核賠功能新增 END-->
	    <action name="commonBatchTaskDeal"  class="undwrtTaskDealAction" method="undwrtTaskDeal">
	      <result name="prepareBatchSubmitSuperior">/pages/undwrt/common/TaskBatchSubmitSuperior.jsp</result>
	      <result name="batchSubmitSuperior">/pages/commonBatchTaskDeal.do?actionType=queryContinue</result>
	      <result name="prepareBatchSubmitJunior">/pages/undwrt/common/TaskBatchSubmitJunior.jsp</result>
	      <result name="batchSubmitJunior">/pages/commonBatchTaskDeal.do?actionType=queryContinue</result>
	      <result name="prepareBatchUndo">/pages/undwrt/common/TaskBatchUndo.jsp</result>
	      <result name="batchUndo">/pages/commonBatchTaskDeal.do?actionType=queryContinue</result>
	      <result name="hepeiQueryContinue">/pages/undwrt/hepei/HepeiTaskDealQueryResult.jsp</result>
	      <result name="failure">/pages/undwrt/common/Message.jsp</result>
	    </action>
	    <!-- 任务校验 -->
	      <action name="CommonCheckTask" class="commonCheckTaskAction" method="commonCheckTask">
	      <result name="success">/pages/undwrt/common/CommonDealContent.jsp</result>
	      <result name="EndorseSuccess">/pages/undwrt/common/EndorseDealContent.jsp</result>
	      <result name="failure">/pages/undwrt/common/Message.jsp</result>
	      <!--add by dengwenchun 20060407 begin 意u20581 险u-248 27）u26680 赔u19981 同u31614 批u20154 校u-25972  -->
	      <result name="fail">/pages/undwrt/common/CheckAdvanceErrorPage.jsp</result>
	      <!-- end -->
	    </action>
	    <!-- 轨迹信息 -->
	    <action name="CommonViewTrace" class="commonViewTraceAction" method="commonViewTrace">
	      <result name="success">/pages/undwrt/common/CommonTraceInfo.jsp</result>
	      <result name="failure">/pages/undwrt/common/Message.jsp</result>
	    </action>
	    <!-- 这个类被注释掉了 -->
	    <action name="materialInfo" class="com.sinosoft.undwrt.ui.control.facade.UIWfLogMaterialFacade" >
	      <result name="success">/pages/undwrt/common/CommonMaterialInfoList.jsp</result>
	    </action>
	     <!--理赔情况纪录 -->
	    <action name="messageRemarkQueryInfo" class="wfMessageRemarkAction" method="wfMessageRemark">
	      <result name="save">/pages/undwrt/common/MessageEnd.htm</result>
	      <result name="query">/pages/undwrt/common/MessageQueryList.jsp</result>
	    </action>
	    <!--分摊试算-->
	    <action name="ReinsTrialInfo" class="reinsTrialAction" method="reinsTrial">
	      <result name="hepeiSuccess">/pages/undwrt/hepei/ReinsTrialResult.jsp</result>
	      <result name="success">/pages/undwrt/common/CommonReinsSimulate.jsp</result>
	      <result name="failure">/pages/undwrt/common/Message.jsp</result>
	    </action>
	      <!--任务处理-->
	    <action name="CommonDealTask" class="commonDealTaskAction" method="commonDealTask">
	      <result name="save">/pages/undwrt/common/Message.jsp</result>
	      <result name="submit">/pages/undwrt/common/CommonDealList.jsp</result>
	      <result name="SubmitSuperior">/pages/undwrt/common/CommonDealListSubmitSuperior.jsp</result>
	      <result name="SubmitJunior">/pages/undwrt/common/CommonDealListSubmitJunior.jsp</result>
	      <result name="failure">/pages/undwrt/common/Message.jsp</result>
	      <result name="success">/pages/WfLogQuery.do</result>
	      <result name="saveEndorseDangerItem">/pages/CommonCheckTask.do</result>
	      <result name="undoTask">/pages/undwrt/common/Message.jsp</result>
	    </action>
	    <!--  提交任务  -->
	    <action name="CommonSubmitTask" class="commonDealSubmitAction" method="commonDealSubmit">
	      <result name="success">/pages/undwrt/common/Message.jsp</result>
	      <result name="failure">/pages/undwrt/common/CheckAdvanceConditionErrorPage.jsp</result>
	    </action>
	    <!-- 任务查询 -->
	    <!-- 任务查询类是在双核中的 -->
	    <action name="WfLogQuery" class="wfLogQueryAction" method="wfLogQuery">
	      <result name="success">/pages/undwrt/common/WfLogQuerylist.jsp</result>
	      <result name="HebaoSuccess">/pages/undwrt/common/WfLogQueryListHebao.jsp</result>
	      <result name="failure">/pages/undwrt/common/Message.jsp</result>
	    </action>
	</package>
</struts>
