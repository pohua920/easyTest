	<!--数据源定义,使用应用服务器-->
	<bean id="jdbcDataSourceTarget"
		class="ins.framework.jndi.JndiObjectFindFactoryBean">
		<property name="jndiName">
			<value>ddccDataSource</value>
		</property> 
	</bean>
	<!--数据源定义,使用应用服务器 用于JBPM数据源-->
	<bean id="jbpmDataSourceTarget"
		class="ins.framework.jndi.JndiObjectFindFactoryBean">
		<property name="jndiName">
			<value>ddccDataSource</value>
		</property> 
	</bean>
</beans>

