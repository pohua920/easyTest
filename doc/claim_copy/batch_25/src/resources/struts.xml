<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts PUBLIC
	"-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
	"http://struts.apache.org/dtds/struts-2.0.dtd">

<struts>
	<!-- mantis：CLM0181，處理人員：DP0713，需求單編號：新核心-案件備案WS 3.10查詢及記錄留存作業 START-->
	<!-- 是否为struts开发模式 -->
	<!-- 進版注意 dev:true/uat:false/prod:false -->
	<constant name="struts.devMode" value="true" />
	<!-- mantis：CLM0181，處理人員：DP0713，需求單編號：新核心-案件備案WS 3.10查詢及記錄留存作業 END-->
	<!-- mantis：CLM280，處理人員： DP0713 ，需求單編號：修正call區塊鏈 api 設定檔 START -->
	<constant name="compulsoryCaseQuery310.doOutput" value="false" />
	<constant name="compulsoryCaseQuery305.doOutput" value="true" />
	<constant name="compulsoryCaseQuery314.doOutput" value="true" />
	<!-- mantis：CLM280，處理人員： DP0713 ，需求單編號：修正call區塊鏈 api 設定檔 END-->
	<!-- 默认的UI template主题 -->
	<constant name="struts.ui.theme" value="simple" />
	<!-- 默认的国际化地区信息 -->
	<constant name="struts.locale" value="zh_TW" />
	<!-- 国际化信息内码 -->
	<constant name="struts.i18n.encoding" value="GBK" />
	<!-- action的后缀 -->
	<constant name="struts.action.extension" value="do" />
	<!-- 加载附加的国际化属性文件（不包含.properties后缀）。可以增加多个properties文件的名称，使用逗号或者空格分割 -->
	<constant name="struts.custom.i18n.resources" value="i18n/messages" />

	<!-- ObjectFactory接口 -->
	<constant name="struts.objectFactory" value="spring" />
	<!-- 指定当使用SpringObjectFactory时的自动装配逻辑.合法值包括: name, type, auto, 和 constructor (缺省为 name ) -->
	<constant name="struts.objectFactory.spring.autoWire" value="name" />

	<!-- 允许动态方法调用 -->
	<constant name="struts.enable.DynamicMethodInvocation" value="false" />

	<!-- 是否国际化信息自动加载 -->
	<constant name="struts.i18n.reload" value="true" />
	<!-- 是否自动加载xml配置(true,false) -->
	<constant name="struts.configuration.xml.reload" value="false" />

	<!-- 是否spring应该使用自身的cache -->
	<constant name="struts.objectFactory.spring.useClassCache" value="true" />
	<constant name="struts.freemarker.templatesCache" value="false" />
	<!-- 是否struts过滤器中提供的静态内容应该被浏览器缓存在头部属性中 -->
	<constant name="struts.serve.static.browserCache" value="true" />
	<!-- 是否struts过滤器应该提供静态内容 -->
	<constant name="struts.serve.static" value="true" />
	<!-- 是否不缓存XSLT模版 -->
	<constant name="struts.xslt.nocache" value="false" />

	<!-- 基准包，所有Struts模块配置文件均需继承default而不是struts-default -->
	<package name="default" extends="struts-default">
		<interceptors>
			<interceptor-stack name="myStack">
				<interceptor-ref name="tokenSession" >
					<!-- 表單是否重複提交攔截校驗 -->
					<param name="includeMethods">*EditPost,registCancel,claimCancel,commonDealTask,commonDealSubmit,giveupTask,checkAcciEdit</param>
					<!-- 不進行表單是否重複提交校驗的方法 -->
					<!-- <param name="excludeMethods"></param> -->
				</interceptor-ref>
				<interceptor-ref name="defaultStack" />
			</interceptor-stack>
		</interceptors>
		<default-interceptor-ref name="myStack"></default-interceptor-ref>
		<default-action-ref name="notFound" />
		<global-results>
			<result name="success">
				/common/Success.jsp
			</result>
			<result name="invalid.token">
				/common/token.jsp
			</result>
			<result name="error">
				/pages/Error.jsp
			</result>
			<result name="failure">
				/common/failure.jsp
			</result>
			<result name="processtoken">
				/common/processtoken.jsp
			</result>
		</global-results>
		
		<global-exception-mappings>
			<!-- 
			<exception-mapping result="error" exception="java.lang.Exception">
			</exception-mapping>
			-->
			<exception-mapping result="failure" exception="com.sinosoft.sysframework.exceptionlog.UserException" />
			<exception-mapping result="processtoken" exception="com.sinosoft.claim.common.util.ProcessTokenException" />
		</global-exception-mappings>
		<!-- 
		<action name="notFound">
			<result>/common/404.jsp</result>
		</action>
 		-->

	</package>

	<include file="struts/struts-common.xml" />
	
	<!-- mantis： CLM0040，處理人員：BK007 蘇哲，需求單編號：CLM0040 外來人口統一證號格式修正  -->
	<!-- 通用Action 如:驗證輸入資料  -->
	<include file="struts/struts-tlg-common.xml"/>
	
	<!-- mantis： CLM0075，處理人員：BK007 蘇哲，需求單編號：CLM0075.理賠系統-修改或刪除已失效匯款帳戶  -->
	<!-- 賠付帳戶維護功能  -->
	<include file="struts/struts-ctbcins-paymentAccount.xml"/>
	
	<include file="struts/claim/struts-claim-chenpeng.xml" />

	<!-- 人员管理信息 -->
	<include file="struts/struts-user.xml" />
	<!--机构管理信息 -->
	<include file="struts/struts-company.xml" />
	<!-- 菜单配置 -->
	<include file="struts/saa/struts-saamenu.xml" />
	<!-- 立案节点-->
	<include file="struts/struts-claim-yanyafei.xml" />
	<!-- 调度节点-->
	<include file="struts/struts-claim-yangfang.xml" />
	<include file="struts/struts-liudaoping.xml" />
	<!-- 定损节点 -->
	<include file="struts/struts-chenjie.xml" />
	<!-- 核赔流程 -->
	<include file="struts/struts-undwrt-liudaoping.xml"/>
	<!-- 外估机构-->
	<include file="struts/struts-claim-zhangmaoyu.xml" />
	<!-- 代查勘节点-->
	<include file="struts/struts-sunlin.xml" />
	<!-- 平台相关-->
	<include file="struts/struts-platform.xml" />
	<!-- 打印相关-->
	<include file="struts/claim/struts-claim-print.xml" />
	<!-- 受益人訊息 ，保益訊息-->
	<include file="struts/struts-claim-liuyang.xml" />
	<!-- 共保问题-->
	<include file="struts/struts-claim-liuwei.xml" />
	<!-- 打印相关-->
	<include file="struts/struts-claim-zhaoxianyang.xml" />
</struts>

