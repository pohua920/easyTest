<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE struts PUBLIC
        "-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
        "http://struts.apache.org/dtds/struts-2.0.dtd">

<struts>
	<package name="commonCommon" extends="default" namespace="/commonCommon">
		<action name="prepareCodeInput" class="ins.framework.web.Struts2Action" method="execute">
			<result name="success">/common/PrepareCodeInput.jsp</result>
		</action>

        <action name="processCodeInput" class="codeInputAction" method="query">
			<result name="success">/common/QueryCodeInputOverviewResult.jsp</result>
		</action>

		<action name="processCodeInputContinue" class="codeInputAction" method="queryContinue">
			<result name="success">/common/QueryCodeInputOverviewResult.jsp</result>
		</action>

		<action name="changeCodeInput" class="codeInputAction" method="query">
			<result name="success">/common/ChangeCodeInput.jsp</result>
		</action>
	</package>

	<package name="common" extends="default" namespace="/common">
		<action name="login" class="loginAction" method="login">
			<!-- <result name="success">/main.jsp</result> -->
			<result name="success">/common/MainFrame.jsp</result>
			<result name="false">/index.jsp</result>
		</action>

		<action name="processCodeInput" class="processCodeInputAction"
			method="getComCodeOptionsText" />

		<action name="processUtiMenu" class="processUtiMenuAction"
			method="showMenu">
			<result name="success"></result>
		</action>

		<!-- 备注记录 -->
		<action name="messageRemarkQueryInfo" class="wfMessageRemarkAction"
				method="wfMessageRemark">
				<result name="query">/pages/undwrtRemarks/MessageQueryList.jsp
				</result>
				<result name="save" type="redirect-action">
					<param name="actionName">
						messageRemarkQueryInfo?messageId=${messageId}&amp;businessNo=${businessNo}&amp;actionType=query
					</param>		
			    </result>
		</action>
		<!-- 历次审核意见 -->
		<action name="commonViewTrace" class="commonViewTraceAction"
			method="getExaminationHistory">
			<result name="success">/pages/undwrtExamination/CommonTraceInfo.jsp
			</result>
			<result name="failure">/pages/undwrtExamination/Message.jsp
			</result>
		</action>
		<!--密码修改 -->
		<action name="userModifyPwd" class="userModifyPwdAction"
			method="modifyPwd">
			<result name="success">/common/MessagePage.jsp</result>
			<result name="failure">/common/Message.jsp</result>
		</action>
		 <action name="blackMaintenance"  class="blackMaintenanceAction" method="blackMaintenance"> 
		      <result name="save">/common/BlackMaintenance.jsp?flag=1</result> 
		      <result name="query">/common/BlackMaintenance.jsp?flag=0</result> 
		      <result name="update">/common/BlackMaintenance.jsp?flag=3</result> 
		      <result name="success">/common/BlackMaintenance.jsp?flag=1</result> 
		      <result name="delete">/common/BlackMaintenance.jsp?flag=1</result> 
		      <result name="new">/common/BlackMaintenance.jsp?flag=1</result>
		      <result name="list">/common/BlackMaintenance.jsp?flag=1</result> 	      
		   </action>
	</package>
</struts>
