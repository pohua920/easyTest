<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE struts PUBLIC
        "-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
        "http://struts.apache.org/dtds/struts-2.0.dtd">

<struts>
	<!--核保处理菜单-->
    <package name="undwrtDeal" extends="default" namespace="/undwrtDeal">
        <action name="hebaoTaskDeal" class="undwrtTaskDealAction" method="hebaoTaskDeal">
	      <result name="prepareQueryAuthorizeControl">/pages/undwrtDeal/AuthorizeControlQuery.jsp</result>
	      <result name="queryAuthorizeControl">/pages/undwrtDeal/AuthorizeControlQueryResult.jsp</result>
	      <result name="prepareQuery">/pages/undwrtDeal/HebaoTaskDealQuery.jsp</result>
	      <result name="prepareQueryQta">/pages/undwrtDeal/HebaoTaskDealQuery.jsp</result>
	      <result name="prepareQueryShow">/pages/undwrtDeal/HebaoTaskShowQuery.jsp</result>
	      <result name="prepareQueryQtaStats">/pages/undwrtDeal/HebaoQueryQtaStats.jsp</result>
	      <result name="queryQtaStats">/pages/undwrtDeal/HebaoQueryQtaStatsResult.jsp</result>
	      <result name="query">/pages/undwrtDeal/HebaoTaskDealQueryResult.jsp</result>
	      <result name="queryQta">/pages/undwrtDeal/HebaoTaskDealQueryQtaResult.jsp</result>
	      <result name="qtaQueryContinue">/pages/undwrtDeal/HebaoTaskDealQueryQtaResult.jsp</result>
	      <result name="hebaoQueryContinue">/pages/undwrtDeal/HebaoTaskDealQueryResult.jsp</result>
	      <result name="retract">/pages/undwrtDeal/HebaoRetractQuery.jsp</result>
	      <result name="failure">/common/Message.jsp</result>
        </action>
        <action name="hebaoTaskDealForWorkStatus" class="undwrtTaskDealAction" method="getWorkStatus">
        </action>
        <action name="hebaoTaskDealForValueType" class="undwrtTaskDealAction" method="getValueType">
        </action>
        <action name="getWorkStatusAndValueType" class="undwrtTaskDealAction" method="getWorkStatusAndValueType">
        </action>
        <action name="amlSystem" class="undwrtTaskDealAction" method="amlSystem">
        </action>
        <action name="hebaoTaskDealForPayRef" class="undwrtTaskDealAction" method="getPayRef">
        </action>
        <action name="updatePayRef" class="undwrtTaskDealAction" method = "updatePayRef">
        	<result name = "success">
        	     /common/payRefSuccess.jsp
        	</result>
        </action>
        <action name="queryBankInfo" class="undwrtTaskDealAction" method="queryBankInfo">
        </action>
        <action name="getPayFeeInfo" class="undwrtTaskDealAction" method="getPayFeeInfo">
        	<result name = "success">
        	     /common/PayFeeInfo.jsp
        	</result>
        </action>
    </package>
    
    <!-- 任务校验 -->
    <package name="taskCheck" extends="default" namespace="/taskCheck">
		<action name="commonCheckTask" class="commonCheckTaskAction" method="commonCheckTask" >
			<result name="showAuthorizeControl">/common/AuthorizeDealContent.jsp</result>
		  	<result name="showAuthorizeControlEndorse">/pages/undwrtDeal/AuthorizeEndorseDealContent.jsp</result>
		  	<result name="success">/pages/undwrtDeal/CommonDealContent.jsp</result>
		  	<result name="qtaSuccess">/common/CommonDealContentQta.jsp</result>
		  	<result name="PolicySuccess">/common/PolicyDealContent.jsp</result>
		  	<result name="EndorseSuccess">/pages/undwrtDeal/EndorseDealContent.jsp</result>
		  	<result name="failure">/common/Message.jsp</result>
		  	<!--意健险（27）核赔不同签批人校验 -->
		  	<result name="fail">/common/CheckAdvanceErrorPage.jsp</result>
		  	<result name="reins">/pages/undwrtDeal/CommonDangerReinsUnit.jsp</result>
		  	<result name="carReins">/pages/undwrtDeal/CarDangerReinsUnit.jsp</result>
		 	<result name="showDangerItem">/pages/undwrtDeal/ShowDangerItem.jsp</result>
		  	<result name="showEndorseDangerItem">/pages/undwrtDeal/showEndorseDangerItem.jsp</result>
		</action>
    </package>
</struts>