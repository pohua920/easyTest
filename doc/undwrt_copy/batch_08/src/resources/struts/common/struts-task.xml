<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE struts PUBLIC
        "-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
        "http://struts.apache.org/dtds/struts-2.0.dtd">

<struts>
    <!-- 提交任务  -->
    <package name="submitTask" extends="default" namespace="/submitTask">
		<action name="commonDealSubmit" class="commonDealSubmitAction" method="commonDealSubmit">
	      	<result name="success">/common/Message.jsp</result>
	      	<result name="failure">/common/CheckAdvanceConditionErrorPage.jsp</result>
		</action>
    </package>
    
    <!-- 处理任务 -->
	<package name="handleTask" extends="default" namespace="/handleTask">
		<action name="commonDealTask" class="commonDealTaskAction" method="dealWithTask">
			<result name="save">/common/Message.jsp</result>
          	<result name="cancel">/common/Message.jsp</result>
          	<result name="send1">/common/CommonDealSendTask.jsp</result>
          	<result name="send2">/common/Message.jsp</result>
          	<result name="submit">/common/CommonDealList.jsp</result>
          	<result name="SubmitSuperior">/common/CommonDealListSubmitSuperior.jsp</result>
	      	<result name="SubmitJunior">/common/CommonDealListSubmitJunior.jsp</result>
	      	<result name="failure">/common/Message.jsp</result>
	      	<result name="success">/WfLogQuery.do</result>
          	<result name="saveEndorseDangerItem">/CommonCheckTask.do</result>
      	</action>
	</package>
    
	<!-- 提交任务撤销  -->
    <package name="retractTask" extends="default" namespace="/retractTask">
		<action name="commonRetractTask" class="commonRetractTaskAction" method="retractTask">
	      	<result name="success">/common/Message.jsp</result>
	      	<result name="failure">/common/TaskRetractErrorPage.jsp</result>
		</action>
    </package>
       
    <!-- 批量核保 -->
    <package name="batchCheckPass" extends="default" namespace="/batchCheckPass" >
    <action name="commonBatchTask" class="commonBatchTaskAction"  method="CommonBatchTask">
  			<result name="success">/pages/undwrtDeal/BatchTask.jsp</result> 
			<result name="failure">/common/Message.jsp</result> 
    </action>
    </package>
  
    <!--下发修改 -->
    <package name="passOffModify" extends="default" namespace="/passOffModify" >
		<action name="cancelBatchTask" class="batchTaskAction" method="handleTask">
			<result name="success">/pages/undwrtDeal/BatchTask.jsp</result> 
			<result name="failure">/common/Message.jsp</result> 
		</action> 
	</package>
	
	<!--提交或放弃任务 -->
    <package name="submitOrGiveUpTask" extends="default" namespace="/submitOrGiveUpTask">
		<action name="batchTaskSubmit" class="batchTaskSubmitAction" method="handleTask">
			<result name="submitBefore">/pages/hebao/BatchTaskSubmitList.jsp</result>
          	<result name="saveNotion">/common/Message.jsp></result>
	      	<result name="success">/common/Message.jsp</result>
	     	<result name="failure">/common/Message.jsp</result>
	      	<result name="cancel">/common/Message.jsp</result>
		</action>
	</package>
		<!--查看风险评估信息 -->
      <package name="dangerInfoView" extends="default" namespace="/dangerInfoView">
		<action name="commonDangerRiskInfoView" class="commonDangerRiskInfoViewAction" method="getDangerInfo">
		<result name="success">/pages/undwrtDeal/CommonDangerRiskInfoView.jsp</result>
		<result name="failure">/common/Message.jsp</result>
		</action>
		<!-- 打开核保界面风险等级评估页面 -->
		<action name="commonDangerRiskLevel" class="commonDangerRiskLevelAction" method="getDangerRiskLevel">
		<result name="success">/pages/undwrtDeal/CommonDangerRiskInfo.jsp</result>
		<result name="failure">/common/Message.jsp</result>
		</action>
	</package>
			<!--分保试算 -->
      <package name="reinsTrialInfoView" extends="default" namespace="/reinsTrialInfoView">
		<action name="reinsTrialInfo" class="reinsTrialInfoAction" method="getReinsTrialInfo">
		<result name="hepeiSuccess">/pages/undwrtDeal/ReinsTrialResult.jsp</result>
		<result name="success">/pages/undwrtDeal/CommonReinsSimulate.jsp</result>
		<result name="failure">/common/Message.jsp</result>
		</action>
	</package>
	
	   <!--临分意向 -->
      <package name="saveReins" extends="default" namespace="/saveReins" >
		<action name="enquiryReins" class="enquiryReinsAction" method="saveReinsInfo">
		<result name="success" type="redirect-action">
	      		<param name="namespace">/taskCheck</param>
	      		<param name="actionName">commonCheckTask</param>
	      		<param name="ReinsFlag">1</param>
	      		<param name="dangerNos">${dangerNos}</param>
	      		<param name="CertiNo">${certiNo}</param>
	      		<param name="CertiType">${certiType}</param>
	      		<param name="iRiskCode">${iRiskCode}</param>
	      		<param name="whetherFacing">${whetherFacing}</param>
	    </result>
		<result name="failure">/common/Message.jsp</result>
		<result name="verifyEnquirySuccess">/common/Message.jsp</result>
		</action>
	</package>
		
	   <!--理赔记录 -->
    <package name="claimInfo" extends="default" namespace="/claimInfo">
		<action name="showClaimInfo" class="showClaimInfoAction" method="claimInfoQuery">
		<result name="success">/pages/undwrtDeal/ShowClaimInfo.jsp</result>
		<result name="failure">/common/Message.jsp</result>
		</action>
	</package>

</struts>