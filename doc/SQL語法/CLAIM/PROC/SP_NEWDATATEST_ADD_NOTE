    INSERT INTO PRPLLOSS (COMPENSATENO,RISKCODE,POLICYNO,SERIALNO,ITEMKINDNO,FAMILYNO,FAMILYNAME,KINDCODE,LICENSENO,ITEMCODE,LOSSNAME,ITEMADDRESS,FEETYPECODE,FEETYPENAME,LOSSQUANTITY,UNIT,UNITPRICE,BUYDATE,DEPRERATE,CURRENCY,AMOUNT,CURRENCY1,ITEMVALUE,CURRENCY2,SUMLOSS,SUMREST,INDEMNITYDUTYRATE,CLAIMRATE,CURRENCY3,DEDUCTIBLERATE,DEDUCTIBLE,CURRENCY4,SUMREALPAY,FLAG,REJECTREASON,DUTYDEDUCTIBLERATE,DRIVERDEDUCTIBLERATE,REMARK,ARRANGERATE,RATIFYPAY,SUMDEFPAY,EXCEPTDEDUCTIBLERATE,EXCEPTDEDUCTIBLEPAY,DANGERNO,COMPELPAY,CARREALVALUE,PAYOBJECTSERIALNO,COMPELPAYTYPE,PRESUMLOSS,EXCHRATE,RESERVEDESTIMATE,ACCIDENTTYPE)
