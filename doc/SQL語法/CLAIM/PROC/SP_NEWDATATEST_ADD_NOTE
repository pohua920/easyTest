    FROM BUSINESS.PRPLLOSS@PROD T WHERE T.COMPENSATENO IN (SELECT COMPENSATENO FROM BUSINESS.PRPLCOMPENSATE@PROD T WHERE T.POLICYNO = (U_POLICYNO) GROUP BY COMPENSATENO)
    AND NOT EXISTS (
    SELECT CKT.COMPENSATENO FROM BUSINESS.PRPLLOSS CKT WHERE CKT.COMPENSATENO = T.COMPENSATENO 
    AND CKT.COMPENSATENO IN (SELECT COMPENSATENO FROM BUSINESS.PRPLCOMPENSATE@PROD CT WHERE CT.POLICYNO = (U_POLICYNO) GROUP BY CT.COMPENSATENO)    
    );
