將第一段的 TABLE 都加上@PROD 如下(參考資料，依照你原來的去增加)
INSERT INTO temp_compensate_list (compensateno)
	SELECT DISTINCT payobj_.COMPENSATENO
	FROM BUSINESS.PRPLPAYOBJECTINFO@PROD payobj_ 
	RIGHT JOIN (
		SELECT wflog_step1.* 
		FROM BUSINESS.WFLOG@PROD wflog0_ 
		RIGHT JOIN (
			SELECT * FROM (  
				SELECT DISTINCT WFLOG.*   
				FROM BUSINESS.WFLOG@PROD   
				WHERE (
					(WFLOG.NODENO <= 5 AND (1 = 1 AND (WFLOG.CLASSCODE IN ('A', 'B') OR WFLOG.RISKCODE IN ('A01'))))
				)   
				AND WFLOG.LOGNO <> 1   
				AND WFLOG.NODENO <> 1   
				AND (WFLOG.BUSINESSTYPE = 'C' OR WFLOG.BUSINESSTYPE = 'Y')   
				AND RISKCATEGORY = 'D'  
				AND RISKCODE IN('A01')   
				AND NODESTATUS IN('0','1','2','3')  
				AND FLOWINTIME >= p_FLOWINTIME_START
				AND FLOWINTIME <= p_FLOWINTIME_END
			)   
			WHERE (OPERATORCODE IS NULL OR OPERATORCODE = 'BL011')  
			ORDER BY FLOWINTIME DESC 
		) wflog_step1 ON wflog0_.FLOWID = wflog_step1.FLOWID AND wflog0_.LOGNO = wflog_step1.LOGNO
	) wflogStep2 ON payobj_.COMPENSATENO = wflogStep2.businessNo 
	AND payobj_.UNIFORMNO = p_UNIFORMNO
	AND payobj_.PAYCODETYPE = '1'
WHERE payobj_.COMPENSATENO IS NOT NULL;
		

