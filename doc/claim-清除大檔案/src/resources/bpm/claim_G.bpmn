    <sequenceFlow id="_125-_77" sourceRef="_125" targetRef="_77" name="結案" tns:priority="1" >
      <conditionExpression xsi:type="tFormalExpression" language="http://www.java.com/java" >return "4".equals(paramsMap.get("status")) &amp;&amp; new Boolean(String.valueOf(paramsMap.get("autoEndCase")));</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="_5-_131" sourceRef="_5" targetRef="_131" name="查勘" tns:priority="1" >
      <conditionExpression xsi:type="tFormalExpression" language="http://www.java.com/java" >return "4".equals(paramsMap.get("status")) &amp;&amp; !(new Boolean(String.valueOf(paramsMap.get("simpleFlowFlag"))));</conditionExpression>
