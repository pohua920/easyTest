  <process processType="Private" isExecutable="true" id="claim_reCase_05" name="claim_reCase_05" tns:packageName="defaultPackage" >

    <!-- process variables -->
    <property id="nodeType" itemSubjectRef="_nodeTypeItem"/>
    <property id="nodeList" itemSubjectRef="_nodeListItem"/>

    <!-- nodes -->
    <startEvent id="_1" name="StartProcess" />
    <endEvent id="_2" name="End" >
        <terminateEventDefinition />
    </endEvent>
    <userTask id="_3" name="重开赔案申请" >
      <ioSpecification>
        <inputSet>
        </inputSet>
        <outputSet>
        </outputSet>
      </ioSpecification>
      <potentialOwner>
        <resourceAssignmentExpression>
          <formalExpression>recase</formalExpression>
        </resourceAssignmentExpression>
      </potentialOwner>
    </userTask>
    <userTask id="_5" name="理算" >
      <ioSpecification>
        <dataOutput id="_5_nodeTypeOutput" name="nodeType" />
        <inputSet>
        </inputSet>
        <outputSet>
          <dataOutputRefs>_5_nodeTypeOutput</dataOutputRefs>
        </outputSet>
      </ioSpecification>
      <dataOutputAssociation>
        <sourceRef>_5_nodeTypeOutput</sourceRef>
        <targetRef>nodeType</targetRef>
      </dataOutputAssociation>
      <potentialOwner>
        <resourceAssignmentExpression>
          <formalExpression>compe</formalExpression>
        </resourceAssignmentExpression>
      </potentialOwner>
    </userTask>
    <userTask id="_6" name="核赔" >
      <ioSpecification>
        <dataOutput id="_6_nodeTypeOutput" name="nodeType" />
        <inputSet>
        </inputSet>
        <outputSet>
          <dataOutputRefs>_6_nodeTypeOutput</dataOutputRefs>
        </outputSet>
      </ioSpecification>
      <dataOutputAssociation>
        <sourceRef>_6_nodeTypeOutput</sourceRef>
        <targetRef>nodeType</targetRef>
      </dataOutputAssociation>
      <potentialOwner>
        <resourceAssignmentExpression>
          <formalExpression>veric</formalExpression>
        </resourceAssignmentExpression>
      </potentialOwner>
    </userTask>
    <userTask id="_7" name="结案" >
      <ioSpecification>
        <dataOutput id="_7_nodeTypeOutput" name="nodeType" />
        <inputSet>
        </inputSet>
        <outputSet>
          <dataOutputRefs>_7_nodeTypeOutput</dataOutputRefs>
        </outputSet>
      </ioSpecification>
      <dataOutputAssociation>
        <sourceRef>_7_nodeTypeOutput</sourceRef>
        <targetRef>nodeType</targetRef>
      </dataOutputAssociation>
      <potentialOwner>
        <resourceAssignmentExpression>
          <formalExpression>endca</formalExpression>
        </resourceAssignmentExpression>
      </potentialOwner>
    </userTask>
    <exclusiveGateway id="_8" name="Gateway" gatewayDirection="Converging" />
    <exclusiveGateway id="_14" name="Gateway" gatewayDirection="Converging" />
    <userTask id="_17" name="注销拒赔" >
      <ioSpecification>
        <dataOutput id="_17_nodeTypeOutput" name="nodeType" />
        <inputSet>
        </inputSet>
        <outputSet>
          <dataOutputRefs>_17_nodeTypeOutput</dataOutputRefs>
