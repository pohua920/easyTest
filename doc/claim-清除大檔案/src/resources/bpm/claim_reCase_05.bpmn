      </ioSpecification>
      <dataOutputAssociation>
        <sourceRef>_17_nodeTypeOutput</sourceRef>
        <targetRef>nodeType</targetRef>
      </dataOutputAssociation>
      <potentialOwner>
        <resourceAssignmentExpression>
          <formalExpression>cance</formalExpression>
        </resourceAssignmentExpression>
      </potentialOwner>
    </userTask>
    <userTask id="_16" name="申请注销拒赔" >
      <ioSpecification>
        <inputSet>
        </inputSet>
        <outputSet>
        </outputSet>
      </ioSpecification>
      <potentialOwner>
        <resourceAssignmentExpression>
          <formalExpression>request_cancel</formalExpression>
        </resourceAssignmentExpression>
      </potentialOwner>
    </userTask>
    <exclusiveGateway id="_19" name="Gateway" gatewayDirection="Diverging" />
    <exclusiveGateway id="_18" name="Gateway" gatewayDirection="Converging" />
    <inclusiveGateway id="_21" name="Gateway" gatewayDirection="Diverging" />
    <parallelGateway id="_20" name="Gateway" gatewayDirection="Diverging" />

    <!-- connections -->
    <sequenceFlow id="_14-_2" sourceRef="_14" targetRef="_2" />
    <sequenceFlow id="_1-_3" sourceRef="_1" targetRef="_3" />
    <sequenceFlow id="_8-_5" sourceRef="_8" targetRef="_5" />
    <sequenceFlow id="_5-_6" sourceRef="_5" targetRef="_6" />
    <sequenceFlow id="_21-_7" sourceRef="_21" targetRef="_7" name="手工结案" tns:priority="1" >
      <conditionExpression xsi:type="tFormalExpression" language="http://www.java.com/java" >return "endca".equals(nodeType);</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="_20-_8" sourceRef="_20" targetRef="_8" />
    <sequenceFlow id="_21-_8" sourceRef="_21" targetRef="_8" name="核赔通过" >
      <conditionExpression xsi:type="tFormalExpression" language="http://www.java.com/java" >return "compe".equals(nodeType)||"endca".equals(nodeType);</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="_19-_14" sourceRef="_19" targetRef="_14" name="注销拒赔审批通过" tns:priority="1" >
      <conditionExpression xsi:type="tFormalExpression" language="http://www.java.com/java" >return "end".equals(nodeType);</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="_21-_14" sourceRef="_21" targetRef="_14" name="自动结案" >
      <conditionExpression xsi:type="tFormalExpression" language="http://www.java.com/java" >return "end".equals(nodeType);</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="_7-_14" sourceRef="_7" targetRef="_14" />
    <sequenceFlow id="_16-_17" sourceRef="_16" targetRef="_17" />
    <sequenceFlow id="_18-_16" sourceRef="_18" targetRef="_16" />
    <sequenceFlow id="_17-_19" sourceRef="_17" targetRef="_19" />
    <sequenceFlow id="_19-_18" sourceRef="_19" targetRef="_18" name="注销拒赔退回" tns:priority="1" >
      <conditionExpression xsi:type="tFormalExpression" language="http://www.java.com/java" >return !"end".equals(nodeType);</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="_20-_18" sourceRef="_20" targetRef="_18" />
    <sequenceFlow id="_6-_21" sourceRef="_6" targetRef="_21" />
    <sequenceFlow id="_3-_20" sourceRef="_3" targetRef="_20" />

  </process>

