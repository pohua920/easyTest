    <!-- connections -->
    <sequenceFlow id="_83-_2" sourceRef="_83" targetRef="_2" />
    <sequenceFlow id="_2-_5" sourceRef="_2" targetRef="_5" />
    <sequenceFlow id="_5-_6" sourceRef="_5" targetRef="_6" name="立案" tns:priority="1" >
      <conditionExpression xsi:type="tFormalExpression" language="http://www.java.com/java" >return "4".equals(paramsMap.get("status"));</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="_93-_77" sourceRef="_93" targetRef="_77" name="結案" tns:priority="1" >
      <conditionExpression xsi:type="tFormalExpression" language="http://www.java.com/java" >return "4".equals(paramsMap.get("status")) &amp;&amp; paramsMap.get("endcaFlag")!=null;</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="_60-_84" sourceRef="_60" targetRef="_84" />
    <sequenceFlow id="_5-_16" sourceRef="_5" targetRef="_16" name="備案註銷" tns:priority="1" >
      <conditionExpression xsi:type="tFormalExpression" language="http://www.java.com/java" >return true;</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="_16-_18" sourceRef="_16" targetRef="_18" />
    <sequenceFlow id="_1-_83" sourceRef="_1" targetRef="_83" />
    <sequenceFlow id="_5-_83" sourceRef="_5" targetRef="_83" tns:priority="1" >
