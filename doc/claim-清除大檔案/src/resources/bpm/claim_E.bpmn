    </sequenceFlow>
    <sequenceFlow id="_29-_93" sourceRef="_29" targetRef="_93" />
    <sequenceFlow id="_89-_92" sourceRef="_89" targetRef="_92" name="提交核賠" tns:priority="1" >
      <conditionExpression xsi:type="tFormalExpression" language="http://www.java.com/java" >return "4".equals(paramsMap.get("status"));</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="_91-_92" sourceRef="_91" targetRef="_92" />
    <sequenceFlow id="_77-_95" sourceRef="_77" targetRef="_95" />
    <sequenceFlow id="_32-_27" sourceRef="_32" targetRef="_27" />
    <sequenceFlow id="_93-_94" sourceRef="_93" targetRef="_94" name="結束" tns:priority="1" >
      <conditionExpression xsi:type="tFormalExpression" language="http://www.java.com/java" >return "4".equals(paramsMap.get("status")) &amp;&amp; paramsMap.get("endcaFlag")==null;</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="_92-_29" sourceRef="_92" targetRef="_29" />
    <sequenceFlow id="_27-_89" sourceRef="_27" targetRef="_89" />
    <sequenceFlow id="_90-_88" sourceRef="_90" targetRef="_88" />
    <sequenceFlow id="_88-_91" sourceRef="_88" targetRef="_91" />
    <sequenceFlow id="_89-_90" sourceRef="_89" targetRef="_90" name="計算書" tns:priority="1" >
      <conditionExpression xsi:type="tFormalExpression" language="http://www.java.com/java" >return "4".equals(paramsMap.get("status")) || "2".equals(paramsMap.get("status"));</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="_91-_90" sourceRef="_91" targetRef="_90" />
    <sequenceFlow id="_93-_90" sourceRef="_93" targetRef="_90" name="核賠退回" tns:priority="1" >
      <conditionExpression xsi:type="tFormalExpression" language="http://www.java.com/java" >return "5".equals(paramsMap.get("status"));</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="_6-_32" sourceRef="_6" targetRef="_32" />
    <sequenceFlow id="_89-_32" sourceRef="_89" targetRef="_32" tns:priority="1" >
      <conditionExpression xsi:type="tFormalExpression" language="http://www.java.com/java" >return true;</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="_84-_36" sourceRef="_84" targetRef="_36" />
    <sequenceFlow id="_93-_96" sourceRef="_93" targetRef="_96" name="自動結案" tns:priority="2" >
      <conditionExpression xsi:type="tFormalExpression" language="http://www.java.com/java" >return "4".equals(paramsMap.get("status")) &amp;&amp; new Boolean(String.valueOf(paramsMap.get("autoEndCase")));</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="_36-_40" sourceRef="_36" targetRef="_40" />
    <sequenceFlow id="_5-_61" sourceRef="_5" targetRef="_61" name="註銷拒賠" tns:priority="1" >
      <conditionExpression xsi:type="tFormalExpression" language="http://www.java.com/java" >return "4".equals(paramsMap.get("status"));</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="_84-_61" sourceRef="_84" targetRef="_61" />
    <sequenceFlow id="_61-_60" sourceRef="_61" targetRef="_60" />

