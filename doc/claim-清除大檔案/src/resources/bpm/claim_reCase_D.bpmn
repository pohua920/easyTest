    <sequenceFlow id="_29-_2" sourceRef="_29" targetRef="_2" name="自動結案" tns:priority="2" >
      <conditionExpression xsi:type="tFormalExpression" language="http://www.java.com/java" >return "4".equals(paramsMap.get("status")) &amp;&amp; new Boolean(String.valueOf(paramsMap.get("autoEndCase")));</conditionExpression>
