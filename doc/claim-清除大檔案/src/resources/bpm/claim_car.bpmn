      <ioSpecification>
        <inputSet>
        </inputSet>
        <outputSet>
        </outputSet>
      </ioSpecification>
    </userTask>
    <parallelGateway id="_9" name="Gateway" gatewayDirection="Diverging" />
    <userTask id="_10" name="理算" >
      <ioSpecification>
        <inputSet>
        </inputSet>
        <outputSet>
        </outputSet>
      </ioSpecification>
    </userTask>

    <!-- connections -->
