    <property id="nodeList" itemSubjectRef="_nodeListItem"/>
    <property id="nodeListThree" itemSubjectRef="_nodeListThreeItem"/>

    <!-- nodes -->
    <exclusiveGateway id="_68" name="Gateway" gatewayDirection="Diverging" />
    <startEvent id="_1" name="StartProcess" />
    <userTask id="_2" name="报案" >
