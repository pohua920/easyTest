    <sequenceFlow id="_67-2-5-_67-2-6" sourceRef="_67-2-5" targetRef="_67-2-6" name="结束" tns:priority="1" >
      <conditionExpression xsi:type="tFormalExpression" language="http://www.jboss.org/drools/rule" >return "end".equals("nodeType");</conditionExpression>
    </sequenceFlow>
    </subProcess>
