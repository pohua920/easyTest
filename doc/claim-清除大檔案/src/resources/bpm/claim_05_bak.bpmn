    <sequenceFlow id="_67-2-5-_67-2-2" sourceRef="_67-2-5" targetRef="_67-2-2" name="追偿" tns:priority="1" >
      <conditionExpression xsi:type="tFormalExpression" language="http://www.java.com/java" >return "replevy".equals(nodeType);</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="_67-2-6-_67-2-4" sourceRef="_67-2-6" targetRef="_67-2-4" />
    <sequenceFlow id="_67-2-1-_67-2-5" sourceRef="_67-2-1" targetRef="_67-2-5" />
