<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts PUBLIC
	"-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
	"http://struts.apache.org/dtds/struts-2.0.dtd">
<struts>
	<!-- 外部机构任务 处理 -->
	<package name="externalAgency" extends="default" namespace="/externalAgency">
		<action name="externalagency" class="externalAgencyAction"
			method="externalAgency">
			<result name="queryMain">/pages/common/query/ExternalAgencyMain.jsp
			</result>
			<result name="queryResult">/pages/common/query/ExternalAgencyResult.jsp
			</result>
			<result name="add">/pages/common/query/ExternalAgencyEdit.jsp
			</result>
			<result name="show">/pages/common/query/ExternalAgencyShow.jsp
			</result>
			<result name="result">/pages/common/query/ExternalAgencyInsertResult.jsp
			</result>
			<result name="update">/pages/common/query/ExternalAgencyUpdate.jsp
			</result>
		</action>
		<action name="insuranceSurveyor" class="insuranceSurveyorAction"
			method="insuranceSurveyor">
			<result name="queryResult">/pages/common/query/InsuranceSurveyorResult.jsp
			</result>
			<result name="show">/pages/common/query/InsuranceSurveyorShow.jsp</result>
			<result name="result">/pages/common/query/InsuranceSurveyorInsertResult.jsp
			</result>
			<result name="update">/pages/common/query/InsuranceSurveyorUpdate.jsp
			</result>
		</action>
	</package>
	<!-- 核赔权限管理 -->
	<package name="undwrtpower" extends="default" >
	<action name="flowNodeCancel" class="flowNodeCancelPostAction" method="flowNodeCancelPost">
	</action>
	   <action name="RelateBusinessNo" class="relateBusinessNoAction" method="relateBusinessNo" >
	   <result name="success">/pages/common/pub/RelateBusinessNo.jsp</result>
   </action>
      <!-- 公估师评分 -->
   <action name="AssessorScore" class="assessorScoreAction" method="assessorScore">
       <result name="show">/pages/common/pub/AssessorShow.jsp</result>
       <result name="insert">/pages/common/pub/AssessorEdit.jsp</result>
       <result name="result">/pages/common/pub/AssessorInsertResult.jsp</result>
   </action>
	</package>
		<!-- 殘餘物任务 -->
	<package name="remnant" extends="default">
	     <action name="remnantResultQuery" class="remnantResultQueryAction" method="remnantResultQuery" >
	    </action> 
	    <action name="remnantBeforeEdit" class="remnantBeforeEditAction" method="remnantBeforeEdit" >
	    	<result name="add">/pages/common/remnant/RemnantEdit.jsp</result>
	    	<result name="edit">/pages/common/remnant/RemnantEdit.jsp</result>
	    	<result name="undwrt">/pages/common/remnant/RemnantEdit.jsp</result>
	    	<result name="show">/pages/common/remnant/RemnantEdit.jsp</result>
	    </action> 
	    <action name="remnantSave" class="remnantSaveAction" method="remnantSave" >
	      <result name="false">/index.jsp</result>
	      <result name="undwrt">/pages/common/pub/MessagePage.jsp</result>
	      <result name="withdrawal">/pages/common/pub/MessagePage.jsp</result>
	    </action> 
	</package>
</struts>