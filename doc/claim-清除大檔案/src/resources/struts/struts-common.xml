	    <!-- 代码对照管理 开始 -->
	    <action name="initPerfCodeTransferManage" class="PerfCodeTransferAction" method="initPerfCodeTransferManage">
		    <result name="success">/pages/platform/common/codeManage/PerfCodeTransferManage.jsp</result>
		</action>
		<action name="queryPerfCodeTransfer" class="PerfCodeTransferAction" method="queryPerfCodeTransfer">
		    <result name="success">/pages/platform/common/codeManage/PerfCodeTransferManage.jsp</result>
		</action>
		<action name="initPerfCodeTransferInput" class="PerfCodeTransferAction" method="initPerfCodeTransferInput">
		    <result name="success">/pages/platform/common/codeManage/PerfCodeTransferEdit.jsp</result>
		</action>
		<action name="initUpdatePerfCodeTransfer" class="PerfCodeTransferAction" method="initUpdatePerfCodeTransfer">
		    <result name="success">/pages/platform/common/codeManage/PerfCodeTransferUpdate.jsp</result>
		</action>
		<action name="savePerfCodeTransfer" class="PerfCodeTransferAction" method="savePerfCodeTransfer" />
		<action name="deletePerfCodeTransfer" class="PerfCodeTransferAction" method="deletePerfCodeTransfer" />
		<!-- 代码对照管理 结束 -->
		
	    <!-- 公共方法  开始 -->
	    <action name="downloadFileTemplate" class="pubToolsAction" method="downloadFileTemplate">
		</action>
