<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE struts PUBLIC
        "-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
        "http://struts.apache.org/dtds/struts-2.0.dtd">

<struts>
	<package name="menu" extends="default" namespace="/menu">
		<action name="showMenu"	class="menuAction"	method="showMenu">
			<result name="success">/pages/main.jsp</result>
		</action>
	</package>
	<package name="pages" extends="default" namespace="/pages">
		<action name="*" class="ins.framework.web.Struts2Action" 
			method="execute">
			<result name="success">/pages/{1}.jsp</result>
		</action>
	</package>
	
	<package name="cacheManager" extends="default" namespace="/cacheManager">
		<action name="*" class="ins.framework.web.Struts2Action" method="execute">
		    <result name="success">/pages/common/{1}.jsp</result>
		</action>
	</package>

	<package name="common" extends="default" namespace="/common">
		<action name="processCodeInputS" class="processCodeInputAction" method="getComCodeOptionsText">
   		</action>
   		
        <action name="login" class="loginAction" method="login">
            <result name="success">/common/SystemFrame.jsp</result>
            <result name="false">/index.jsp</result>
        </action>
        
        <action name="processUtiMenu" class="processUtiMenuAction" method="showMenu">
            <result name="success"></result>
        </action>
	
		<action name="PrepareCodeInput" class="ins.framework.web.Struts2Action"
			method="execute">
			<result name="success">
				/common/PrepareCodeInput.jsp
			</result>
		</action>
		
		<action name="processCodeInput" class="codeInputAction"
			method="query">
			<result name="success">
				/pages/common/pub/QueryCodeInputResult.jsp
			</result>
			<result name="query">
				/pages/common/pub/QueryCodeInputResult.jsp
			</result>
		</action>
		
		<action name="changeCodeInput" class="codeInputAction"
			method="query">
			<result name="success">
				/common/ChangeCodeInput.jsp
			</result>
			<result name="query">
				/common/ChangeCodeInput.jsp
			</result>
		</action>
		
		<action name="processCodeInputContinue" class="codeInputAction"
			method="queryContinue">
			<result name="success">
				/common/QueryCodeInputOverviewResult.jsp
			</result>
		</action>
		
		<action name="exitframe" class="loginAction"
			method="exitframe">
			<result name="success">
					/login.jsp
			</result>
		</action>
		
		<action name="otherOperate" class="codeInputAction"
			method="otherOperate">
			<result name="success">
				/pages/common/otherOperate.jsp
			</result>
		</action>
		
		<action name="rebuildCompanyGrade" class="codeInputAction"
			method="rebuildCompanyGrade">
			<result name="success">
				/pages/Success.jsp
			</result>
		</action>
		
		<action name="clearMemory" class="codeInputAction"
			method="clearMemory">
			<result name="success">
				/pages/common/clearMemorySuccess.jsp
			</result>
		</action>
	    
