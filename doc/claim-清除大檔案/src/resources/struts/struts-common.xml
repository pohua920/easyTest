			<result name="success">/maintenance/bankQueryResultData.jsp</result>
		</action>
		<action name="bankBeforeEdit" class="autoBankAction" method="bankBeforeEdit">
			<result name="success">/maintenance/bankEdit.jsp</result>
		</action>
		<action name="saveBank" class="autoBankAction" method="saveBank">
		</action>
		<!-- 自动填充给付类别 -->
		<action name="autoPaymentTypeAction" class="autoPaymentTypeAction" method="autoPaymentType">
		</action>
		<action name="verificationPaymentType" class="autoPaymentTypeAction" method="verificationPaymentType">
		</action>
		<!-- mantis：CLM0125，處理人員：DP0713，需求單編號：新功能理賠人員資料維護 START -->
		<action name="employeeQuery" class="claimEmployeeAction" method="employeeQuery">
			<result name="success">/maintenance/employeeQueryResultData.jsp</result>
		</action>
		<action name="employeeBeforeEdit" class="claimEmployeeAction" method="employeeBeforeEdit">
			<result name="success">/maintenance/employeeEdit.jsp</result>
		</action>
		<action name="saveEmployee" class="claimEmployeeAction" method="saveEmployee">
		</action>
		<!-- mantis：CLM0125，處理人員：DP0713，需求單編號：新功能理賠人員資料維護 END -->
