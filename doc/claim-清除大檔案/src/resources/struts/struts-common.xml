		<action name="prepareAdd" method="prepareAdd" class="validatorAction">
		   <result name="success">
		   		/pages/platform/common/validator/ValidatorEdit.jsp
		   </result>
		</action>
		
		<action name="editValidator" method="editValidator" class="validatorAction">
			<result name="success">
				/pages/platform/common/validator/ValidatorEdit.jsp
			</result>
		</action>
		
		<action name="query" method="query" class="validatorAction">
		</action>
		
		<action name="prepareQuery" method="prepareQuery" class="validatorAction">
			<result name="success">
				/pages/platform/common/validator/ValidatorQuery.jsp
			</result>
		</action>
	</package>
	<!-- mantis：CLM0181，處理人員：DP0713，需求單編號：新核心-案件備案WS 3.10查詢及記錄留存作業 START -->
