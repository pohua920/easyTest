	    <action name="initPerfTypeManage" class="PerfTypeAction" method="initPerfTypeManage">
		    <result name="success">/pages/platform/common/codeManage/PerfTypeManage.jsp</result>
		</action>
		<action name="queryPerfType" class="PerfTypeAction" method="queryPerfType">
		    <result name="success">/pages/platform/common/codeManage/PerfTypeManage.jsp</result>
		</action>
