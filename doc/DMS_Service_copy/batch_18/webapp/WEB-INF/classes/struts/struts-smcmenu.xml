<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE struts PUBLIC
        "-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
        "http://struts.apache.org/dtds/struts-2.0.dtd">

<struts>
	<package name="smcMenu" extends="struts-default" namespace="/smcMenu">
		<action name="selectSvr" class="menuAction" method="selectSvr">
			<result name="success">/pages/ims/menu/selectSvr.jsp</result>
		</action> 
		<action name="prepareFrame" class="menuAction" method="prepareFrame">
			<result name="success">/pages/ims/menu/smcMenuFrame.jsp</result>
		</action> 
		<action name="getMenuList" class="menuAction" method="getMenuList">
			<result name="success">/pages/ims/menu/menuTree.jsp</result>
		</action> 
		<action name="prepareInsertMenu" class="menuAction" method="prepareInsertMenu">
			<result name="success">/pages/ims/menu/menuEdit.jsp</result>
		</action> 
		<action name="prepareUpdateMenu" class="menuAction" method="prepareUpdateMenu">
			<result name="success">/pages/ims/menu/menuEdit.jsp</result>
		</action> 
		<action name="insertMenu" class="menuAction" method="insertMenu">
			<result name="success">/pages/ims/menu/addSuccess.jsp</result>
		</action> 
		<action name="updateMenu" class="menuAction" method="updateMenu">
			<result name="success">/pages/ims/menu/addSuccess.jsp</result>  
		</action> 
<action name="viewMenu" class="menuAction" method="viewMenu">
			<result name="success">/pages/ims/menu/menuView.jsp</result>  
		</action>
		<action name="delMenu" class="menuAction" method="delMenu">
			<result name="success">/pages/ims/menu/addSuccess.jsp</result>  
		</action>
		<action name="loadSubFun" class="menuAction" method="loadSubFun"></action>
	</package> 
</struts>
