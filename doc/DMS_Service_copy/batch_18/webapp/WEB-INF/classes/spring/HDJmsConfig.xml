	<!-- POJO which send Message uses  Spring JmsTemplate --><!--配置消息发送者-->
	<bean id="messageProducer" class="cn.com.sinosoft.ims.sync.HDMessageProducer">
		<property name="tempMap">
			<map>
				<entry key="BC_Temp">
					<ref bean="bctemp" />
				</entry>
<!-- 			<entry key="HD_Temp_F">
						<ref bean="hdtempf" />
				</entry>
 -->
			</map>
		</property>
		<property name="destMap">
			<map>
				<entry key="BC_Topic">
					<ref bean="bcdest" />
				</entry>

<!-- 			<entry key="HD_Topic_F">
					<ref bean="hddestf" />
				</entry>
 -->	
			</map>
		</property>

	</bean>

